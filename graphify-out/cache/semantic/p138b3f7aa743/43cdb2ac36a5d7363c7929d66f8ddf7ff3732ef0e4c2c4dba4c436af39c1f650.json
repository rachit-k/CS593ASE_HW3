{"nodes": [{"id": "changes_jinja_changelog", "label": "Jinja Changelog (CHANGES.rst)", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_version_3_2_0", "label": "Version 3.2.0 (Unreleased)", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops Python 3.7-3.9, raises MarkupSafe>=3.0 and Babel>=2.17, deprecates __version__ in favor of importlib.metadata/feature detection, moves to pyproject.toml metadata with flit_core build backend instead of setuptools/setup.cfg."}, {"id": "changes_version_3_1_6", "label": "Version 3.1.6", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Security fix: |attr filter no longer bypasses environment attribute lookup so the sandbox can apply its checks (GHSA cpwx-vrp4-4pq7)."}, {"id": "changes_version_3_1_5", "label": "Version 3.1.5", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sandbox handles indirect str.format calls, escapes template names in error messages, async generator cleanup (aclose), FileSystemLoader error lists searched paths."}, {"id": "changes_version_3_1_4", "label": "Version 3.1.4", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_version_3_1_0", "label": "Version 3.1.0", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes previously deprecated code: WithExtension/AutoEscapeExtension built in, context*/evalcontext*/environment* decorators replaced by pass_* decorators, Markup/escape must come from MarkupSafe."}, {"id": "changes_version_3_0_0", "label": "Version 3.0.0", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L213", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drops Python 2.7/3.5, adds type hints, PEP 451 PackageLoader, required blocks, unified pass_* decorators, async no longer requires self-patching."}, {"id": "changes_version_2_11_0", "label": "Version 2.11.0", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L343", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last version to support Python 2.7/3.5; adds ChainableUndefined, debug extension, better tracebacks, NativeTemplate fixes."}, {"id": "changes_version_2_10", "label": "Version 2.10", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L477", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_version_2_9", "label": "Version 2.9 (codename Derivation)", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L619", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduces async mode, policies, scoping-system overhaul so include/import propagate context consistently, built-in with/autoescape tags."}, {"id": "changes_version_2_0", "label": "Version 2.0 (codename Jinjavitus)", "file_type": "document", "source_file": "CHANGES.rst", "source_location": "L1042", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_sandboxedenvironment", "label": "SandboxedEnvironment", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L472", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated security fixes (str.format, str.format_map, |attr, clear/pop on mutable sequences, operator intercepting) to prevent code execution and information leakage from untrusted templates."}, {"id": "changes_pass_decorators", "label": "pass_context / pass_eval_context / pass_environment decorators", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unified, renamed replacements for contextfunction/contextfilter, evalcontextfunction/evalcontextfilter, environmentfunction/environmentfilter (deprecated in 3.0, removed in 3.1)."}, {"id": "changes_async_mode", "label": "Async mode (enable_async)", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L630", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added in 2.9 for Python 3.6 async iterators; since 3.0 no longer patches Jinja itself; sync render of async templates uses asyncio.run."}, {"id": "changes_nativeenvironment", "label": "NativeEnvironment / NativeTemplate", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L511", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders templates to native Python types instead of strings."}, {"id": "changes_packageloader", "label": "PackageLoader", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses PEP 451 API since 3.0; earlier attempt to drop setuptools/pkg_resources was reverted in 2.11.2 due to Pytest issues and Python 2 support difficulty."}, {"id": "changes_filesystemloader", "label": "FileSystemLoader", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_undefined_types", "label": "Undefined / StrictUndefined / ChainableUndefined", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L350", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_urlize_filter", "label": "urlize filter", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_xmlattr_filter", "label": "xmlattr filter", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disallows keys with spaces, /, >, = for security (GHSA advisories); user input should never be used as keys."}, {"id": "changes_bytecode_cache", "label": "Bytecode cache system", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L1031", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_i18n_extension", "label": "i18n extension ({% trans %}, gettext/pgettext)", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_required_blocks", "label": "Required blocks", "file_type": "concept", "source_file": "CHANGES.rst", "source_location": "L233", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changes_scoping_system", "label": "Scoping system overhaul (2.9)", "file_type": "rationale", "source_file": "CHANGES.rst", "source_location": "L656", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Made scoping consistent with designer/developer expectations; no magic difference between include and import constructs, context always propagated the same way."}, {"id": "changes_traceback_rewriting", "label": "Template traceback rewriting", "file_type": "concept", "source_file": "CHANGES.r